# ==========================================
# Dados Temporários, Scraper e RDBM Dumps
# ==========================================
# Perfil de sessão do navegador usado para contornar o Cloudflare
data/.sofifa_browser/
data/raw/

# Backups binários pesados do EA FC e tabelas brutas do RDBM
data/backup_squads/
data/rdbm_clean/*.txt
data/exports/

# NOTA: O arquivo data/draftfc_local.db NÃO está ignorado abaixo para que
# você possa subir o banco de jogadores pronto para o campeonato no GitHub.
# Caso queira ignorá-lo no futuro, descomente a linha abaixo:
# data/draftfc_local.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

